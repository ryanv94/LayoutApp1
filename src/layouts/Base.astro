---
import '@fontsource-variable/fraunces';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/controls.css';
import { PRIVACY, TOOL } from '../data/tools';
interface Props { title?: string }
const { title = `${TOOL.name} — photo print layouts` } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={TOOL.blurb} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header develop" style="--i:0">
      <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
        <circle cx="18" cy="18" r="16" fill="none" stroke="#e5352b" stroke-width="2" />
        <path d="M18 2 L26 16 M34 18 L20 26 M18 34 L10 20 M2 18 L16 10" stroke="#ede6da" stroke-width="2" fill="none" />
      </svg>
      <div>
        <h1>{TOOL.name}</h1>
        <span class="tag edge">▸ 01A · {TOOL.blurb}</span>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><p id="privacy">{PRIVACY}</p></footer>
  </body>
</html>
