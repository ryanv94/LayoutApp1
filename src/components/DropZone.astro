<div id="drop" class="drop">
  <label class="drop-label" for="files">
    <span class="drop-title">Drop 6–10 photos here</span>
    <span class="hint">or click to choose — JPEG, PNG, WebP. Nothing leaves your device.</span>
  </label>
  <input class="visually-hidden" type="file" id="files" accept="image/*" multiple />
</div>
